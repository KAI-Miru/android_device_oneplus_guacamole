+bool RunResetprop(const char* name, const char* value) {
+    const pid_t pid = fork();
+    if (pid < 0) {
+        LOGERR("[OPLUS DECRYPT] system identity: fork failed for %s: %s\n", name, strerror(errno));
+        return false;
+    }
+    if (pid == 0) {
+        execl("/system/bin/resetprop", "resetprop", name, value,
+              static_cast<char*>(nullptr));
+        _exit(127);
+    }
+
+    int status = 0;
+    if (waitpid(pid, &status, 0) != pid) {
+        LOGERR("[OPLUS DECRYPT] system identity: waitpid failed for %s: %s\n", name, strerror(errno));
+        return false;
+    }
+    if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+        LOGERR("[OPLUS DECRYPT] system identity: resetprop failed for %s, status=%d\n", name, status);
+        return false;
+    }
+
+    const std::string actual = ReadProperty(name);
+    if (actual != value) {
+        LOGERR("[OPLUS DECRYPT] system identity: resetprop verification failed for %s: got=%s expected=%s\n",
+               name, actual.c_str(), value);
+        return false;
+    }
+    return true;
+}
