+bool DiscoverInstalledSystemIdentity(std::string* release, std::string* patch) {
+    std::string slot_suffix = ReadProperty("ro.boot.slot_suffix");
+    if (slot_suffix.empty()) {
+        const std::string slot = ReadProperty("ro.boot.slot");
+        if (slot == "a" || slot == "b") slot_suffix = "_" + slot;
+    }
+    if (slot_suffix != "_a" && slot_suffix != "_b") {
+        LOGERR("[OPLUS DECRYPT] system identity: unable to determine active system slot: suffix=%s\n",
+               slot_suffix.c_str());
+        return false;
+    }
+
+    MountedSystem existing;
+    if (FindMountedDynamicSystem(&existing)) {
+        LOGINFO("[OPLUS DECRYPT] system identity: using mounted dynamic system: source=%s mount=%s fs=%s\n",
+                existing.source.c_str(), existing.mount_point.c_str(), existing.fs_type.c_str());
+        if (ReadIdentityFromRoot(existing.mount_point, release, patch)) return true;
+        LOGERR("[OPLUS DECRYPT] system identity: mounted dynamic system has no reliable release/SPL pair\n");
+    }
+
+    const std::vector<std::string> blocks = {
+        "/dev/block/mapper/system" + slot_suffix,
+        "/dev/block/mapper/system",
+        "/dev/block/bootdevice/by-name/system",
+        "/dev/block/bootdevice/by-name/system" + slot_suffix,
+    };
+    constexpr char kMountPoint[] = "/tmp/h40-installed-system";
+    if (mkdir(kMountPoint, 0700) != 0 && errno != EEXIST) {
+        LOGERR("[OPLUS DECRYPT] system identity: mkdir failed: %s\n", strerror(errno));
+        return false;
+    }
+
+    constexpr unsigned long kReadOnlyFlags = MS_RDONLY | MS_NOSUID | MS_NODEV | MS_NOEXEC;
+    std::string mounted_block;
+    const char* mounted_type = nullptr;
+    int last_error = ENOENT;
+    for (const auto& block : blocks) {
+        if (mount(block.c_str(), kMountPoint, "ext4", kReadOnlyFlags, "") == 0) {
+            mounted_block = block;
+            mounted_type = "ext4";
+            break;
+        }
+        last_error = errno;
+        if (mount(block.c_str(), kMountPoint, "erofs", kReadOnlyFlags, "") == 0) {
+            mounted_block = block;
+            mounted_type = "erofs";
+            break;
+        }
+        last_error = errno;
+    }
+    if (!mounted_type) {
+        LOGERR("[OPLUS DECRYPT] system identity: read-only system mount failed for slot %s: %s\n",
+               slot_suffix.c_str(), strerror(last_error));
+        rmdir(kMountPoint);
+        return false;
+    }
+
+    LOGINFO("[OPLUS DECRYPT] system identity: installed system mounted read-only: slot=%s block=%s fs=%s\n",
+            slot_suffix.c_str(), mounted_block.c_str(), mounted_type);
+
+    const bool found = ReadIdentityFromRoot(kMountPoint, release, patch);
+
+    if (umount(kMountPoint) != 0) {
+        LOGERR("[OPLUS DECRYPT] system identity: failed to unmount installed system: %s\n", strerror(errno));
+        return false;
+    }
+    rmdir(kMountPoint);
+
+    if (!found) {
+        LOGERR("[OPLUS DECRYPT] system identity: no reliable release/SPL pair found in installed system\n");
+        return false;
+    }
+    return true;
+}
