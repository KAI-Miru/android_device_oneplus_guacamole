+struct MountedSystem {
+    std::string source;
+    std::string mount_point;
+    std::string fs_type;
+};
+
+bool FindMountedDynamicSystem(MountedSystem* mounted) {
+    std::ifstream mounts("/proc/mounts");
+    if (!mounts.is_open()) return false;
+
+    MountedSystem system_root;
+    std::string line;
+    while (std::getline(mounts, line)) {
+        std::istringstream fields(line);
+        MountedSystem candidate;
+        std::string options;
+        if (!(fields >> candidate.source >> candidate.mount_point >> candidate.fs_type >> options)) {
+            continue;
+        }
+        if (candidate.mount_point != "/system" && candidate.mount_point != "/system_root") {
+            continue;
+        }
+        if (candidate.fs_type != "ext4" && candidate.fs_type != "erofs") continue;
+        if (!HasMountOption(options, "ro")) continue;
+        if (candidate.source.find("/dev/block/dm-") != 0 &&
+            candidate.source.find("/dev/block/mapper/") != 0 &&
+            candidate.source.find("/dev/block/bootdevice/by-name/system") != 0) {
+            continue;
+        }
+        if (candidate.mount_point == "/system") {
+            *mounted = candidate;
+            return true;
+        }
+        system_root = candidate;
+    }
+    if (!system_root.mount_point.empty()) {
+        *mounted = system_root;
+        return true;
+    }
+    return false;
+}
