+bool IsOplusMapperMountedAtData(const std::string& mapper) {
+	struct stat mapper_status = {};
+	struct stat data_status = {};
+	if (stat(mapper.c_str(), &mapper_status) != 0) {
+		LOGERR("[OPLUS DECRYPT] cannot stat metadata mapper '%s': %s\n",
+			mapper.c_str(), strerror(errno));
+		return false;
+	}
+	if (!S_ISBLK(mapper_status.st_mode)) {
+		LOGERR("[OPLUS DECRYPT] metadata mapper is not a block device: %s\n",
+			mapper.c_str());
+		return false;
+	}
+	if (stat("/data", &data_status) != 0) {
+		LOGERR("[OPLUS DECRYPT] mounted /data cannot be inspected: %s\n", strerror(errno));
+		return false;
+	}
+	if (!S_ISDIR(data_status.st_mode)) {
+		LOGERR("[OPLUS DECRYPT] /data is not a directory after OEM metadata setup\n");
+		return false;
+	}
+	if (data_status.st_dev != mapper_status.st_rdev) {
+		LOGERR("[OPLUS DECRYPT] /data device %llu does not match mapper %s device %llu\n",
+			static_cast<unsigned long long>(data_status.st_dev), mapper.c_str(),
+			static_cast<unsigned long long>(mapper_status.st_rdev));
+		return false;
+	}
+	return true;
+}
