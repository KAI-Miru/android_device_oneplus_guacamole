+template <std::size_t N>
+bool WaitForQuiescentServices(const char* const (&services)[N]) {
+    int stable_polls = 0;
+    for (int poll = 0; poll < kUnmountServiceWaitPolls; ++poll) {
+        bool all_quiescent = true;
+        for (const char* service : services) {
+            const std::string state = ReadProperty(std::string("init.svc.") + service);
+            if (!state.empty() && state != "stopped" && state != "disabled") {
+                all_quiescent = false;
+                break;
+            }
+        }
+        if (all_quiescent) {
+            if (++stable_polls >= kUnmountStableServicePolls) return true;
+        } else {
+            stable_polls = 0;
+        }
+        usleep(kServicePollIntervalUs);
+    }
+
+    LOGINFO("[OPLUS DECRYPT] data unmount: credential services did not quiesce in time\n");
+    for (const char* service : services) {
+        const std::string state = ReadProperty(std::string("init.svc.") + service);
+        LOGINFO("[OPLUS DECRYPT] data unmount: init.svc.%s=%s\n",
+                service, state.c_str());
+    }
+    return false;
+}
