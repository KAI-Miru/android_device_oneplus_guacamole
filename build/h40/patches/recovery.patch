+#include <string>
+
+namespace twrp {
+namespace oplus_h40 {
+
+// Values needed to construct TWRP's deliberately minimal user-0-only FBE
+// state without invoking TeamWin vold's keystore2-backed DE implementation.
+struct User0State {
+    int raw_password_type = 0;
+    int twrp_password_type = 0;
+    bool no_credential = false;
+    std::string crypto_block_device;
+};
+
+// Unavailable is possible only before the OEM implementation has performed
+// any side effect. kModernHandoff is the sole explicit transition into TeamWin
+// decryption, and is returned only after the isolated OEM gate accepts the
+// credential. kRejected is the only retryable outcome; kFatalFailure latches
+// every ambiguous or infrastructure failure for the recovery process lifetime.
+enum class Result {
+    kUnavailable,
+    kRejected,
+    kFatalFailure,
+    kModernHandoff,
+    kSuccess,
+};
+
+bool IsActive();
+Result PrepareMetadataRuntime();
+Result MountMetadataAndPrepareDe(const std::string& mount_point, User0State* user0_state);
+Result DecryptUser(const std::string& password, int user_id);
