+bool WaitForStoppedGatekeeper() {
+    for (int poll = 0; poll < kServiceWaitPolls; ++poll) {
+        if (ReadProperty("init.svc.gatekeeperd") == "stopped") return true;
+        usleep(kServicePollIntervalUs);
+    }
+    LOGERR("[OPLUS DECRYPT] gatekeeperd did not stop before metadata mapping (state=%s)\n",
+           ReadProperty("init.svc.gatekeeperd").c_str());
+    return false;
+}
