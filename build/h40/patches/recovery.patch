+alignas(16) unsigned char g_signal_stack[64 * 1024];
+alignas(4) std::uint32_t g_stage =
+        static_cast<std::uint32_t>(protocol::Stage::kStarting);
+alignas(8) std::uint64_t g_attempt_id = 0;
