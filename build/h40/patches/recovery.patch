+
+Result PrepareMetadataRuntime() {
+    std::lock_guard<std::mutex> lock(GetRuntimeMutex());
+    if (!EnsureFscryptSessionKeyring()) {
+        return FailActive("fscrypt session keyring unavailable before metadata decrypt");
+    }
+    LOGINFO("[OPLUS DECRYPT] keyring: ready before TWRP metadata decrypt\n");
+
+    const Api& api = GetApi();
+    if (api.handle == nullptr) return Result::kUnavailable;
+
+    RuntimeState& state = GetRuntimeState();
+    if (state.phase == Phase::kFatal) return Result::kFatalFailure;
+    if (state.phase == Phase::kActive || state.phase == Phase::kPreparedLocked ||
+        state.phase == Phase::kPreparedNoLock || state.phase == Phase::kUnlocked) {
+        return Result::kSuccess;
+    }
+    if (state.phase != Phase::kIdle) {
+        return FailActive("unexpected phase before TWRP metadata runtime preparation");
+    }
+
+    state.phase = Phase::kActive;
+    LOGINFO("[OPLUS DECRYPT] hybrid activated; TWRP owns metadata mapping, OEM owns DE/CE\n");
+
+    if (!PrepareMetadataServices()) {
+        return FailActive("metadata crypto services unavailable");
+    }
+
+    // V4.1: TeamWin KeyStorage is compiled against a direct HIDL Keymaster 4.0
+    // backend. PrepareMetadataServices() above has already brought up the H.40
+    // qsee/keymaster/hwservicemanager stack, so no Keystore2 Binder daemon is
+    // needed for metadata-key retrieval.
+    LOGINFO("[OPLUS DECRYPT] metadata backend: direct HIDL Keymaster 4.0\n");
+    return Result::kSuccess;
+}
+
+bool IsActive() {
+    std::lock_guard<std::mutex> lock(GetRuntimeMutex());
+    return GetRuntimeState().phase != Phase::kIdle;
+}
+
+Result MountMetadataAndPrepareDe(const std::string& mount_point, User0State* user0_state) {
+    std::lock_guard<std::mutex> lock(GetRuntimeMutex());
+    if (user0_state == nullptr || mount_point != "/data") {
+        LOGERR("[OPLUS DECRYPT] refusing invalid metadata request for '%s'\n",
+               mount_point.c_str());
+        return Result::kFatalFailure;
+    }
+
+    const Api& api = GetApi();
+    if (api.handle == nullptr) return Result::kUnavailable;
+
+    RuntimeState& state = GetRuntimeState();
+    if (state.phase == Phase::kFatal) return Result::kFatalFailure;
+    if (state.phase == Phase::kPreparedLocked || state.phase == Phase::kPreparedNoLock) {
+        *user0_state = state.user0;
+        return Result::kSuccess;
+    }
+    if (state.phase == Phase::kUnlocked) {
+        return FailActive("metadata preparation requested after CE unlock");
+    }
+    if (state.phase != Phase::kActive) {
+        return FailActive("TWRP metadata handoff requested before runtime preparation");
+    }
+
+    LOGINFO("[OPLUS DECRYPT] hybrid adopting TWRP metadata mapping for %s\n",
+            mount_point.c_str());
+    if (!ValidateMapper(&state.user0)) return FailActive("TWRP metadata mapper validation failed");
+    if (!MarkDataMappedAndStartGatekeeper()) {
+        return FailActive("post-map property/service sequence failed");
+    }
+    if (!PrepareUser0DeState(api, &state.user0)) {
+        return FailActive("user 0 DE/password state validation failed");
+    }
+
+    state.phase = state.user0.no_credential ? Phase::kPreparedNoLock : Phase::kPreparedLocked;
+    *user0_state = state.user0;
+    return Result::kSuccess;
+}
+
+Result DecryptUser(const std::string& password, int user_id) {
+    std::lock_guard<std::mutex> lock(GetRuntimeMutex());
+    RuntimeState& state = GetRuntimeState();
+    if (state.phase == Phase::kIdle) return Result::kUnavailable;
+    if (state.phase == Phase::kFatal) return Result::kFatalFailure;
+    if (state.phase == Phase::kActive ||
+        state.phase == Phase::kAwaitingModernHandoff ||
+        state.phase == Phase::kUnlocked) {
+        return FailActive("credential request arrived in an invalid adapter phase");
+    }
+
+    // The stock H.40 ABI is hard-wired to user 0, and the exact verifier
+    // patch plus modern handoff is validated only for that user. A secondary
+    // user remains an authoritative refusal, never a generic fallback.
+    if (user_id != 0) {
+        LOGERR("[OPLUS DECRYPT] user0-only mode refusing credential for user %d\n", user_id);
+        return FailActive("credential request targeted an unsupported user");
+    }
+
+    const Api& api = GetApi();
+    if (api.handle == nullptr) return FailActive("OEM ABI disappeared after activation");
+
+    if (password == "!") {
+        if (!state.user0.no_credential) {
+            LOGERR("[OPLUS DECRYPT] refusing no-lock probe for credentialed user 0\n");
+            return FailActive("no-lock credential used for a locked user");
+        }
+
+        // Recheck current CE state instead of trusting the setup-time result.
+        LOGINFO("[OPLUS DECRYPT] rechecking no-credential user 0 CE postcondition\n");
+        state.user0_ce_ready = api.init_user0_ce();
+        LOGINFO("[OPLUS DECRYPT] no-credential user 0 CE recheck returned %d\n",
+                state.user0_ce_ready);
+        if (!state.user0_ce_ready) {
+            return FailActive("no-credential CE recheck failed");
+        }
+        if (!ValidateUser0CeLayout()) {
+            return FailActive("no-credential CE paths are not accessible");
+        }
+        state.phase = Phase::kUnlocked;
+        LOGINFO("[OPLUS DECRYPT] no-lock user 0 CE postcondition satisfied\n");
+        return Result::kSuccess;
+    }
+
+    if (state.user0.no_credential) {
+        LOGERR("[OPLUS DECRYPT] refusing credential verify for no-lock user 0\n");
+        return FailActive("credential supplied for a no-lock user");
+    }
+    if (!PrepareCredentialServices()) {
+        return FailActive("credential services unavailable before isolated verifier");
+    }
+
+    LOGINFO("[OPLUS DECRYPT] credential handoff: launching exact-H.40 isolated credential gate for user 0\n");
+    const IsolatedVerifyResult isolated_result =
+            VerifyCredentialIsolated(password, state.user0.raw_password_type);
+    if (isolated_result == IsolatedVerifyResult::kRejected) {
+        // OEM -1/non-acceptance is retryable. The modern path is never called
+        // for a non-accepted credential, avoiding a second Gatekeeper attempt.
+        return Result::kRejected;
+    }
+    if (isolated_result != IsolatedVerifyResult::kAccepted) {
+        return FailActive("isolated OEM credential gate failed ambiguously");
+    }
+
+    // The exact-hash helper suppresses the OEM Android-10 empty-auth CE init.
+    // Keep the adapter locked until TeamWin derives the real synthetic-password
+    // secret and the fscrypt key/policy proof succeeds.
+    state.phase = Phase::kAwaitingModernHandoff;
+    LOGINFO("[OPLUS DECRYPT] credential handoff: OEM credential accepted; requesting modern SP unwrap\n");
+    return Result::kModernHandoff;
+}
+
+Result CompleteModernHandoff(bool decrypt_succeeded) {
+    std::lock_guard<std::mutex> lock(GetRuntimeMutex());
+    RuntimeState& state = GetRuntimeState();
+    if (state.phase != Phase::kAwaitingModernHandoff) {
+        return FailActive("modern decryption completion arrived in an invalid phase");
+    }
+    if (!decrypt_succeeded) {
+        return FailActive("modern synthetic-password handoff failed after OEM acceptance");
+    }
+    state.user0_ce_ready = ValidateUser0CeLayout();
+    if (!state.user0_ce_ready) {
+        return FailActive("modern handoff returned without CE key/layout proof");
+    }
+    state.phase = Phase::kUnlocked;
+    LOGINFO("[OPLUS DECRYPT] credential handoff: modern user 0 CE postcondition satisfied\n");
+    return Result::kSuccess;
+}
+
+bool PrepareDataUnmount() {
+    std::lock_guard<std::mutex> lock(GetRuntimeMutex());
+    RuntimeState& state = GetRuntimeState();
+
+    // TWRP also unmounts /data during early setup and failed credential paths.
+    // Quiescing the OEM stack there would break the active decrypt attempt, so
+    // this hook is deliberately inert until CE decryption has been proven.
+    if (state.phase != Phase::kUnlocked || !state.data_mapped) return true;
+    if (state.data_services_quiesced) return true;
+
+    LOGINFO("[OPLUS DECRYPT] data unmount: quiescing OEM credential services\n");
+    bool requests_succeeded = true;
+    requests_succeeded &= SetProperty("enable.qseecomd.service", "0");
+    requests_succeeded &= SetProperty("vendor.data.mounted", "0");
+    for (const char* service : kDataBackedServices) {
+        requests_succeeded &= SetProperty("ctl.stop", service);
+    }
+
+    const bool services_quiescent = WaitForQuiescentServices(kDataBackedServices);
+    sync();
+    // Remove_MTP_Storage() is delivered over TWRP's MTP message pipe. Give the
+    // server a bounded interval to release its /data descriptors as well.
+    usleep(kUnmountSettleIntervalUs);
+
+    if (!requests_succeeded || !services_quiescent) return false;
+    state.data_services_quiesced = true;
+    LOGINFO("[OPLUS DECRYPT] data unmount: OEM credential services stopped\n");
+    return true;
+}
