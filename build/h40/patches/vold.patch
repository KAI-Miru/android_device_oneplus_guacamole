+bool Keymaster::getKeyCharacteristics(const std::string& key, km::AuthorizationSet* hwEnforced,
+                                       km::AuthorizationSet* swEnforced) {
+    printf("[Keymaster] getKeyCharacteristics: ENTER keySize=%zu\n", key.size());
