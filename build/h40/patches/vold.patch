+// H.40's ColorOS key directory is accepted only in this exact direct-AES
+// shape.  Every path component is opened relative to its already-validated
+// parent with O_NOFOLLOW; the guard never creates, renames, or unlinks files.
+static bool h40_open_directory_at(int parent_fd, const char* name,
+                                  android::base::unique_fd* result) {
+    const int fd = TEMP_FAILURE_RETRY(
+            openat(parent_fd, name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (fd < 0) {
+        PLOG(ERROR) << "[OPLUS DECRYPT] parent CE key: cannot open directory component " << name;
+        return false;
+    }
+    struct stat status = {};
+    if (fstat(fd, &status) != 0 || !S_ISDIR(status.st_mode)) {
+        PLOG(ERROR) << "[OPLUS DECRYPT] parent CE key: invalid directory component " << name;
+        close(fd);
+        return false;
+    }
+    result->reset(fd);
+    return true;
+}
+
+static bool h40_read_directory_entries(int directory_fd, const char* label,
+                                       std::set<std::string>* entries) {
+    const int scan_fd = TEMP_FAILURE_RETRY(
+            fcntl(directory_fd, F_DUPFD_CLOEXEC, 0));
+    if (scan_fd < 0) {
+        PLOG(ERROR) << "[OPLUS DECRYPT] parent CE key: cannot duplicate " << label;
+        return false;
+    }
+    auto directory = std::unique_ptr<DIR, int (*)(DIR*)>(fdopendir(scan_fd), closedir);
+    if (!directory) {
+        PLOG(ERROR) << "[OPLUS DECRYPT] parent CE key: cannot enumerate " << label;
+        close(scan_fd);
+        return false;
+    }
+
+    entries->clear();
+    errno = 0;
+    while (dirent* entry = readdir(directory.get())) {
+        const std::string name(entry->d_name);
+        if (name == "." || name == "..") continue;
+        if (!entries->insert(name).second) {
+            LOG(ERROR) << "[OPLUS DECRYPT] parent CE key: duplicate entry " << label << "/" << name;
+            return false;
+        }
+        errno = 0;
+    }
+    if (errno != 0) {
+        PLOG(ERROR) << "[OPLUS DECRYPT] parent CE key: failed while enumerating " << label;
+        return false;
+    }
+    return true;
+}
+
+static bool h40_directory_has_exact_entries(int directory_fd,
+                                             const std::set<std::string>& expected,
+                                             const char* label) {
+    std::set<std::string> entries;
+    if (!h40_read_directory_entries(directory_fd, label, &entries)) return false;
+    if (entries != expected) {
+        LOG(ERROR) << "[OPLUS DECRYPT] parent CE key: unsupported entry set in " << label;
+        return false;
+    }
+    return true;
+}
+
+static bool h40_validate_regular_file_at(int directory_fd, const char* name,
+                                         off_t expected_size,
+                                         const char* expected_contents,
+                                         bool reject_all_zero = false) {
+    android::base::unique_fd fd(TEMP_FAILURE_RETRY(
+            openat(directory_fd, name, O_RDONLY | O_NOFOLLOW | O_CLOEXEC)));
+    if (fd < 0) {
+        PLOG(ERROR) << "[OPLUS DECRYPT] parent CE key: cannot open " << name;
+        return false;
+    }
+    struct stat status = {};
+    if (fstat(fd, &status) != 0 || !S_ISREG(status.st_mode) ||
+        status.st_nlink != 1 || status.st_size != expected_size) {
+        LOG(ERROR) << "[OPLUS DECRYPT] parent CE key: malformed " << name
+                   << ": mode=" << status.st_mode
+                   << " links=" << status.st_nlink << " size=" << status.st_size;
+        return false;
+    }
+
+    std::string contents(static_cast<size_t>(expected_size), '\0');
+    size_t offset = 0;
+    while (offset < contents.size()) {
+        const ssize_t count = TEMP_FAILURE_RETRY(
+                read(fd.get(), &contents[offset], contents.size() - offset));
+        if (count <= 0) {
+            PLOG(ERROR) << "[OPLUS DECRYPT] parent CE key: short read from " << name;
+            return false;
+        }
+        offset += static_cast<size_t>(count);
+    }
+    char extra = 0;
+    if (TEMP_FAILURE_RETRY(read(fd.get(), &extra, 1)) != 0) {
+        LOG(ERROR) << "[OPLUS DECRYPT] parent CE key: grew while reading " << name;
+        return false;
+    }
+    if (expected_contents != nullptr && contents != expected_contents) {
+        LOG(ERROR) << "[OPLUS DECRYPT] parent CE key: invalid contents in " << name;
+        return false;
+    }
+    if (reject_all_zero &&
+        std::all_of(contents.begin(), contents.end(), [](char value) { return value == '\0'; })) {
+        LOG(ERROR) << "[OPLUS DECRYPT] parent CE key: all-zero contents in " << name;
+        return false;
+    }
+    return true;
+}
+
+enum class OplusCurrentCeLayout {
+    kInvalid,
+    kDirectAesMinimal,
+    kDirectAesLegacyNone,
+};
+
+static const char* h40_current_ce_layout_name(OplusCurrentCeLayout layout) {
+    switch (layout) {
+        case OplusCurrentCeLayout::kDirectAesMinimal:
+            return "direct-aes-minimal";
+        case OplusCurrentCeLayout::kDirectAesLegacyNone:
+            return "direct-aes-legacy-none";
+        case OplusCurrentCeLayout::kInvalid:
+            return "invalid";
+    }
+    return "invalid";
+}
+
+static OplusCurrentCeLayout validate_h40_modern_user0_ce_layout() {
+    android::base::unique_fd root(TEMP_FAILURE_RETRY(
+            open("/", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)));
+    if (root < 0) {
+        PLOG(ERROR) << "[OPLUS DECRYPT] parent CE key: cannot open filesystem root";
+        return OplusCurrentCeLayout::kInvalid;
+    }
+
+    android::base::unique_fd data, misc, vold, user_keys, ce, user0, current;
+    if (!h40_open_directory_at(root.get(), "data", &data) ||
+        !h40_open_directory_at(data.get(), "misc", &misc) ||
+        !h40_open_directory_at(misc.get(), "vold", &vold) ||
+        !h40_open_directory_at(vold.get(), "user_keys", &user_keys) ||
+        !h40_open_directory_at(user_keys.get(), "ce", &ce) ||
+        !h40_open_directory_at(ce.get(), "0", &user0)) {
+        return OplusCurrentCeLayout::kInvalid;
+    }
+    if (!h40_directory_has_exact_entries(user0.get(), {"current"},
+                                         "/data/misc/vold/user_keys/ce/0")) {
+        return OplusCurrentCeLayout::kInvalid;
+    }
+    if (!h40_open_directory_at(user0.get(), "current", &current)) {
+        return OplusCurrentCeLayout::kInvalid;
+    }
+    std::set<std::string> entries;
+    if (!h40_read_directory_entries(current.get(),
+                                    "/data/misc/vold/user_keys/ce/0/current", &entries)) {
+        return OplusCurrentCeLayout::kInvalid;
+    }
+    const std::set<std::string> minimal = {"encrypted_key", "version"};
+    const std::set<std::string> legacy_none = {
+            "encrypted_key", "secdiscardable", "stretching", "version"};
+    OplusCurrentCeLayout layout = OplusCurrentCeLayout::kInvalid;
+    if (entries == minimal) {
+        layout = OplusCurrentCeLayout::kDirectAesMinimal;
+    } else if (entries == legacy_none) {
+        layout = OplusCurrentCeLayout::kDirectAesLegacyNone;
+    } else {
+        LOG(ERROR) << "[OPLUS DECRYPT] CE layout: unsupported user 0 CE key-directory schema";
+        return OplusCurrentCeLayout::kInvalid;
+    }
+
+    if (!h40_validate_regular_file_at(current.get(), "version", 1, "1")) {
+        return OplusCurrentCeLayout::kInvalid;
+    }
+    // 12-byte GCM nonce + 64-byte fscrypt key + 16-byte GCM tag.
+    if (!h40_validate_regular_file_at(current.get(), "encrypted_key", 92, nullptr)) {
+        return OplusCurrentCeLayout::kInvalid;
+    }
+    if (layout == OplusCurrentCeLayout::kDirectAesLegacyNone) {
+        // Some upgraded ROMs retain Android 11's literal "none" marker and
+        // 16 KiB secdiscardable.  Both remain part of the direct-AES app ID.
+        if (!h40_validate_regular_file_at(current.get(), "stretching", 4, "none") ||
+            !h40_validate_regular_file_at(current.get(), "secdiscardable", 1 << 14,
+                                           nullptr, true)) {
+            return OplusCurrentCeLayout::kInvalid;
+        }
+    }
+    return layout;
+}
+
+bool fscrypt_unlock_user0_key_current_only(const std::string& secret_hex) {
+    constexpr userid_t kUser = 0;
+    LOG(INFO) << "[OPLUS DECRYPT] parent CE key: guarded parent-process CE install";
+    if (!fscrypt_is_native()) {
+        LOG(ERROR) << "[OPLUS DECRYPT] parent CE key: native fscrypt is not active";
+        return false;
+    }
+    if (GetCePolicies().count(kUser) != 0) {
+        LOG(ERROR) << "[OPLUS DECRYPT] parent CE key: user 0 CE policy already exists";
+        return false;
+    }
+    const OplusCurrentCeLayout layout = validate_h40_modern_user0_ce_layout();
+    if (layout == OplusCurrentCeLayout::kInvalid) return false;
+
+    auto auth = authentication_from_hex(secret_hex);
+    if (!auth || auth->secret.empty()) {
+        LOG(ERROR) << "[OPLUS DECRYPT] parent CE key: refusing empty or malformed SP-derived secret";
+        return false;
+    }
+    EncryptionOptions options;
+    if (!get_data_file_encryption_options(&options) || options.use_hw_wrapped_key) {
+        LOG(ERROR) << "[OPLUS DECRYPT] parent CE key: layout requires a non-wrapped data key";
+        return false;
+    }
+
+    // Re-run the no-follow shape guard immediately before retrieveKey().  A
+    // nonempty authentication forces KeyStorage's read-only direct AES-GCM
+    // path.  Keymaster blobs remain forbidden by both accepted entry sets.
+    const OplusCurrentCeLayout revalidated_layout =
+            validate_h40_modern_user0_ce_layout();
+    if (revalidated_layout != layout) {
+        LOG(ERROR) << "[OPLUS DECRYPT] CE layout: user 0 CE schema changed during validation";
+        return false;
+    }
+    LOG(INFO) << "[OPLUS DECRYPT] CE layout: validated " << h40_current_ce_layout_name(layout);
+    const std::string key_path =
+            get_ce_key_current_path(get_ce_key_directory_path(kUser));
+    KeyBuffer ce_key;
+    if (!android::vold::retrieveKey(key_path, *auth, &ce_key)) return false;
+    if (ce_key.size() != FSCRYPT_MAX_KEY_SIZE) {
+        LOG(ERROR) << "[OPLUS DECRYPT] parent CE key: unexpected recovered CE key size " << ce_key.size();
+        return false;
+    }
+
+    EncryptionPolicy ce_policy;
+    if (!install_storage_key(DATA_MNT_POINT, options, ce_key, &ce_policy)) return false;
+    const auto inserted = GetCePolicies().emplace(kUser, ce_policy);
+    if (!inserted.second) {
+        LOG(ERROR) << "[OPLUS DECRYPT] parent CE key: CE policy insertion raced or duplicated";
+        return false;
+    }
+    LOG(INFO) << "[OPLUS DECRYPT] parent CE key: installed user 0 CE key without key-directory mutation";
+    return true;
+}
