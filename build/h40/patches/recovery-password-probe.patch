+enum class PasswordProtectorState {
+    kError,
+    kNoCredential,
+    kCredentialed,
+};
+
+PasswordProtectorState ProbeUser0PasswordProtector() {
+    constexpr char kSpblobPath[] = "/data/system_de/0/spblob";
+    constexpr char kPasswordSuffix[] = ".pwd";
+    constexpr size_t kPasswordSuffixLength = sizeof(kPasswordSuffix) - 1;
+
+    const int directory_fd = TEMP_FAILURE_RETRY(
+            open(kSpblobPath, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (directory_fd < 0) {
+        if (errno == ENOENT) {
+            LOGINFO("[OPLUS DECRYPT] password state: no spblob directory; skipping OEM password-type call\n");
+            return PasswordProtectorState::kNoCredential;
+        }
+        LOGERR("[OPLUS DECRYPT] password state: cannot open %s: %s\n",
+               kSpblobPath, strerror(errno));
+        return PasswordProtectorState::kError;
+    }
+
+    DIR* directory = fdopendir(directory_fd);
+    if (directory == nullptr) {
+        const int saved_errno = errno;
+        close(directory_fd);
+        LOGERR("[OPLUS DECRYPT] password state: cannot enumerate %s: %s\n",
+               kSpblobPath, strerror(saved_errno));
+        return PasswordProtectorState::kError;
+    }
+
+    bool found_password_protector = false;
+    bool valid = true;
+    errno = 0;
+    while (dirent* entry = readdir(directory)) {
+        const size_t name_length = strlen(entry->d_name);
+        if (name_length <= kPasswordSuffixLength ||
+            memcmp(entry->d_name + name_length - kPasswordSuffixLength,
+                   kPasswordSuffix, kPasswordSuffixLength) != 0) {
+            continue;
+        }
+
+        struct stat status = {};
+        if (fstatat(dirfd(directory), entry->d_name, &status, AT_SYMLINK_NOFOLLOW) != 0) {
+            LOGERR("[OPLUS DECRYPT] password state: cannot inspect %s/%s: %s\n",
+                   kSpblobPath, entry->d_name, strerror(errno));
+            valid = false;
+            break;
+        }
+        if (!S_ISREG(status.st_mode) || status.st_nlink != 1 || status.st_size < 4 ||
+            status.st_size > 64 * 1024) {
+            LOGERR("[OPLUS DECRYPT] password state: malformed password protector %s/%s\n",
+                   kSpblobPath, entry->d_name);
+            valid = false;
+            break;
+        }
+        found_password_protector = true;
+    }
+    const int read_errno = errno;
+    closedir(directory);
+    if (!valid || read_errno != 0) {
+        if (valid) {
+            LOGERR("[OPLUS DECRYPT] password state: cannot finish reading %s: %s\n",
+                   kSpblobPath, strerror(read_errno));
+        }
+        return PasswordProtectorState::kError;
+    }
+
+    if (!found_password_protector) {
+        LOGINFO("[OPLUS DECRYPT] password state: no .pwd protector; skipping OEM password-type call\n");
+        return PasswordProtectorState::kNoCredential;
+    }
+    LOGINFO("[OPLUS DECRYPT] password state: validated .pwd protector; OEM password-type call permitted\n");
+    return PasswordProtectorState::kCredentialed;
+}
