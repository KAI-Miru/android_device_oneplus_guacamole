+static bool h40_validate_bounded_regular_file_at(int directory_fd, const char* name,
+                                                 off_t minimum_size, off_t maximum_size) {
+    android::base::unique_fd fd(TEMP_FAILURE_RETRY(
+            openat(directory_fd, name, O_RDONLY | O_NOFOLLOW | O_CLOEXEC)));
+    if (fd < 0) {
+        PLOG(ERROR) << "[OPLUS V57 NOCREDENTIAL] cannot open " << name;
+        return false;
+    }
+    struct stat status = {};
+    if (fstat(fd, &status) != 0 || !S_ISREG(status.st_mode) || status.st_nlink != 1 ||
+        status.st_size < minimum_size || status.st_size > maximum_size) {
+        LOG(ERROR) << "[OPLUS V57 NOCREDENTIAL] malformed " << name
+                   << ": mode=" << status.st_mode << " links=" << status.st_nlink
+                   << " size=" << status.st_size;
+        return false;
+    }
+    return true;
+}
