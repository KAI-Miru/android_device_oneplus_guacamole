+// A no-lock user key is wrapped with an empty KeyAuthentication, which means
+// Keymaster-backed storage in this vold generation.  Validate only the selected
+// current key and leave every on-device key directory byte-for-byte untouched.
+// The optional stretching marker is retained by Android 11 upgrades, while an
+// upgraded Keymaster blob can be left by an interrupted framework checkpoint.
+static bool validate_h40_no_credential_user0_ce_layout() {
+    android::base::unique_fd root(TEMP_FAILURE_RETRY(
+            open("/", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)));
+    if (root < 0) {
+        PLOG(ERROR) << "[OPLUS V57 NOCREDENTIAL] cannot open filesystem root";
+        return false;
+    }
+
+    android::base::unique_fd data, misc, vold, user_keys, ce, user0, current;
+    if (!h40_open_directory_at(root.get(), "data", &data) ||
+        !h40_open_directory_at(data.get(), "misc", &misc) ||
+        !h40_open_directory_at(misc.get(), "vold", &vold) ||
+        !h40_open_directory_at(vold.get(), "user_keys", &user_keys) ||
+        !h40_open_directory_at(user_keys.get(), "ce", &ce) ||
+        !h40_open_directory_at(ce.get(), "0", &user0) ||
+        !h40_open_directory_at(user0.get(), "current", &current)) {
+        return false;
+    }
+
+    std::set<std::string> entries;
+    if (!h40_read_directory_entries(current.get(),
+                                    "/data/misc/vold/user_keys/ce/0/current", &entries)) {
+        return false;
+    }
+    const std::set<std::string> modern = {
+            "encrypted_key", "keymaster_key_blob", "secdiscardable", "version"};
+    const std::set<std::string> legacy = {
+            "encrypted_key", "keymaster_key_blob", "secdiscardable", "stretching", "version"};
+    const std::set<std::string> modern_upgraded = {
+            "encrypted_key", "keymaster_key_blob", "keymaster_key_blob_upgraded",
+            "secdiscardable", "version"};
+    const std::set<std::string> legacy_upgraded = {
+            "encrypted_key", "keymaster_key_blob", "keymaster_key_blob_upgraded",
+            "secdiscardable", "stretching", "version"};
+    if (entries != modern && entries != legacy && entries != modern_upgraded &&
+        entries != legacy_upgraded) {
+        LOG(ERROR) << "[OPLUS V57 NOCREDENTIAL] unsupported user 0 CE key-directory schema";
+        return false;
+    }
+
+    if (!h40_validate_regular_file_at(current.get(), "version", 1, "1") ||
+        !h40_validate_regular_file_at(current.get(), "encrypted_key", 92, nullptr) ||
+        !h40_validate_regular_file_at(current.get(), "secdiscardable", 1 << 14, nullptr, true) ||
+        !h40_validate_bounded_regular_file_at(current.get(), "keymaster_key_blob", 1,
+                                               64 * 1024)) {
+        return false;
+    }
+    if (entries.count("stretching") != 0 &&
+        !h40_validate_regular_file_at(current.get(), "stretching", 4, "none")) {
+        return false;
+    }
+    if (entries.count("keymaster_key_blob_upgraded") != 0 &&
+        !h40_validate_bounded_regular_file_at(current.get(), "keymaster_key_blob_upgraded", 1,
+                                               64 * 1024)) {
+        return false;
+    }
+    return true;
+}
