+bool fscrypt_unlock_user0_key_no_credential_current_only() {
+    constexpr userid_t kUser = 0;
+    LOG(INFO) << "[OPLUS V57 NOCREDENTIAL] guarded parent-process CE install";
+    if (!fscrypt_is_native()) {
+        LOG(ERROR) << "[OPLUS V57 NOCREDENTIAL] native fscrypt is not active";
+        return false;
+    }
+    if (GetCePolicies().count(kUser) != 0) {
+        LOG(INFO) << "[OPLUS V57 NOCREDENTIAL] user 0 CE policy is already installed";
+        return true;
+    }
+    if (!validate_h40_no_credential_user0_ce_layout()) return false;
+
+    EncryptionOptions options;
+    if (!get_data_file_encryption_options(&options)) return false;
+    if (!validate_h40_no_credential_user0_ce_layout()) {
+        LOG(ERROR) << "[OPLUS V57 NOCREDENTIAL] user 0 CE schema changed during validation";
+        return false;
+    }
+
+    const std::string key_path =
+            get_ce_key_current_path(get_ce_key_directory_path(kUser));
+    KeyBuffer ce_key;
+    if (!android::vold::retrieveKey(key_path, GetEmptyAuthentication(), &ce_key)) return false;
+    if (ce_key.size() != FSCRYPT_MAX_KEY_SIZE) {
+        LOG(ERROR) << "[OPLUS V57 NOCREDENTIAL] unexpected recovered CE key size "
+                   << ce_key.size();
+        return false;
+    }
+
+    EncryptionPolicy ce_policy;
+    if (!install_storage_key(DATA_MNT_POINT, options, ce_key, &ce_policy)) return false;
+    const auto inserted = GetCePolicies().emplace(kUser, ce_policy);
+    if (!inserted.second) {
+        LOG(ERROR) << "[OPLUS V57 NOCREDENTIAL] CE policy insertion raced";
+        return false;
+    }
+    LOG(INFO) << "[OPLUS V57 NOCREDENTIAL] installed user 0 CE key without key-directory mutation";
+    return true;
+}
