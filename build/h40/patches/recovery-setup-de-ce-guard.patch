+// Exact OOS 12 H.40 OEM library identity and the one passwordless-only branch
+// inside setup_de_ce(0). get_password_type(0) returns -1 when no lockscreen
+// credential exists; stock recovery then branches into a process-global CE
+// initializer that is unsafe when the library is dlopened by TWRP. The parent
+// recovery performs the real, guarded CE install after DE preparation instead.
+constexpr off_t kExpectedOemFileSize = 1479432;
+constexpr std::array<std::uint8_t, SHA256_DIGEST_LENGTH> kExpectedOemSha256 = {
+        0xd7, 0xff, 0x48, 0x88, 0xd8, 0x80, 0x40, 0x59,
+        0x6b, 0x7c, 0xa6, 0xc1, 0x1e, 0xe9, 0x89, 0x89,
+        0x3b, 0x6c, 0xef, 0x91, 0xba, 0x56, 0x51, 0x20,
+        0x29, 0x61, 0x71, 0x6f, 0x8e, 0x7d, 0xe2, 0xa2,
+};
+constexpr std::uintptr_t kSetupDeCeSymbolOffset = 0x822f0;
+constexpr std::uintptr_t kGetPasswordTypeSymbolOffset = 0x80ab8;
+constexpr std::uintptr_t kNoCredentialBranchOffset = 0x82438;
+constexpr std::uintptr_t kLegacyCeInitOffset = 0x82398;
+constexpr std::uintptr_t kGetPasswordTypePltOffset = 0x15c330;
+constexpr std::uintptr_t kLegacyCeInitPltOffset = 0x15c310;
+constexpr std::uint32_t kNoCredentialBranchInstruction = 0x54fffb00;
+constexpr std::uint32_t kAarch64Nop = 0xd503201f;
+
+struct OpcodeExpectation {
+    std::uintptr_t offset;
+    std::uint32_t original;
+};
+
+constexpr OpcodeExpectation kSetupDeCeOpcodeContext[] = {
+        {kLegacyCeInitOffset, 0x940367de},  // bl fscrypt_init_user0_ce@plt
+        {0x8242c, 0x2a1f03e0},             // mov w0, wzr
+        {0x82430, 0x940367c0},             // bl get_password_type@plt
+        {0x82434, 0x3100041f},             // cmn w0, #1
+        {kNoCredentialBranchOffset, kNoCredentialBranchInstruction},
+        {0x8243c, 0xd0fffda0},             // adrp x0, ...
+};
