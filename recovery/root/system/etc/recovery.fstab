# Android recovery fstab for the converted ColorOS 12.1 H.40 super layout.
#
# H.40's stock recovery fstab marks these volumes logical. The supplied H.40
# images are ext4, while other Android 12 payloads may use EROFS, so retain
# both filesystem alternatives for each shared logical mount point.
# TWRP normalizes /system to /system_root internally. Using /system_root here
# also lets the identically keyed twrp.flags entry apply before normalization.
# first_stage_mount belongs to Android init and is not a TWRP partition flag.

#<src>          <mnt_point>       <type>  <mnt_flags and options>                 <fs_mgr_flags>
system          /system_root      ext4    ro,barrier=1,discard                    wait,slotselect,logical
system          /system_root      erofs   ro                                      wait,slotselect,logical
vendor          /vendor           ext4    ro,barrier=1,discard                    wait,slotselect,logical
vendor          /vendor           erofs   ro                                      wait,slotselect,logical
odm             /odm              ext4    ro,barrier=1,discard                    wait,slotselect,logical
odm             /odm              erofs   ro                                      wait,slotselect,logical
product         /product          ext4    ro,barrier=1,discard                    wait,slotselect,logical
product         /product          erofs   ro                                      wait,slotselect,logical
my_product      /my_product       ext4    ro,barrier=1,discard                    wait,slotselect,logical
my_product      /my_product       erofs   ro                                      wait,slotselect,logical
my_engineering  /my_engineering   ext4    ro,barrier=1                            wait,slotselect,logical
my_engineering  /my_engineering   erofs   ro                                      wait,slotselect,logical

/dev/block/bootdevice/by-name/metadata  /metadata  ext4  noatime,nosuid,nodev,discard  wait,check,formattable
/dev/block/bootdevice/by-name/userdata  /data      ext4  noatime,nosuid,nodev,barrier=1,noauto_da_alloc,discard,inlinecrypt  latemount,wait,check,formattable,fileencryption=ice,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M
/dev/block/bootdevice/by-name/userdata  /data      f2fs  noatime,nosuid,nodev,discard,inlinecrypt                           latemount,wait,check,formattable,fileencryption=ice,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M

# update_engine requires a misc entry to discover the boot device.
/dev/block/bootdevice/by-name/misc      /misc      emmc  defaults  defaults
/dev/block/bootdevice/by-name/boot      /boot      emmc  defaults  slotselect
