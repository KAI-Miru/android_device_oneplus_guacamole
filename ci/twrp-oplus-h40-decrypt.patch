+using android::hardware::defaultServiceManager;
+using android::hidl::base::V1_0::IBase;
+using android::hidl::manager::V1_0::IServiceManager;
+
+constexpr char kLibrary[] = "libdecrypt_recovery.so";
+constexpr char kVerifySymbol[] =
+        "_Z21OplusCredentialVerifyNSt3__112basic_stringIcNS_11char_traitsIcEENS_9allocatorIcEEEEi";
+constexpr char kSetupDeCeSymbol[] = "_Z11setup_de_cei";
+constexpr char kGetPasswordTypeSymbol[] = "_Z17get_password_typei";
+constexpr char kInitUser0CeSymbol[] = "_Z21fscrypt_init_user0_cev";
+constexpr char kMountMetadataSymbol[] =
+        "_Z32fscrypt_mount_metadata_encryptedRKNSt3__112basic_stringIcNS_11char_traitsIcEENS_9allocatorIcEEEE";
+
+constexpr char kCryptoengFqName[] =
+        "vendor.oplus.hardware.cryptoeng@1.0::ICryptoeng";
+constexpr char kCryptoengInstance[] = "default";
+
+// These are the exact service names in the H.40 recovery ramdisk. Requiring
+// consecutive samples rejects an immediate linker-crash loop. The HIDL
+// registry probe below independently proves that cryptoeng registered and is
+// responsive; init's "running" property by itself is not sufficient.
+constexpr const char* kMetadataServices[] = {
+        "hwservicemanager",
+        "keymaster-4-0",
+        "qseecomd",
+        "hal_cryptoeng_oplus",
+};
+constexpr const char* kCredentialHalServices[] = {
+        "vendor.gatekeeper-1-0",
+};
+constexpr int kServiceWaitPolls = 150;
+constexpr int kStableServicePolls = 5;
+constexpr useconds_t kServicePollIntervalUs = 100000;
+
+using VerifyFn = int (*)(std::string, int);
+using SetupDeCeFn = bool (*)(int);
+using GetPasswordTypeFn = int (*)(int);
+using InitUser0CeFn = bool (*)();
+using MountMetadataFn = bool (*)(const std::string&);
+
+struct Api {
+    void* handle = nullptr;
+    VerifyFn verify = nullptr;
+    SetupDeCeFn setup_de_ce = nullptr;
+    GetPasswordTypeFn get_password_type = nullptr;
+    InitUser0CeFn init_user0_ce = nullptr;
+    MountMetadataFn mount_metadata = nullptr;
+};
+
+enum class Phase {
+    kIdle,
+    kActive,
+    kPreparedLocked,
+    kPreparedNoLock,
+    kUnlocked,
+    kFatal,
+};
+
+struct RuntimeState {
+    Phase phase = Phase::kIdle;
+    bool data_mapped = false;
+    bool user0_ce_ready = false;
+    User0State user0;
+};
+
+RuntimeState& GetRuntimeState();
+
+std::mutex& GetRuntimeMutex() {
+    static std::mutex runtime_mutex;
+    return runtime_mutex;
+}
+
+std::string ReadProperty(const std::string& name) {
+    char value[PROPERTY_VALUE_MAX] = {};
+    property_get(name.c_str(), value, "");
+    return value;
+}
+
+bool SetProperty(const char* name, const char* value) {
+    if (property_set(name, value) == 0) return true;
+    LOGERR("Oplus H.40 decrypt: failed to set %s=%s\n", name, value);
+    return false;
+}
+
+Result FailActive(const char* reason) {
+    RuntimeState& state = GetRuntimeState();
+    state.phase = Phase::kFatal;
+    LOGERR("Oplus H.40 v3 adapter entered process-lifetime fatal state: %s\n", reason);
+    return Result::kFailure;
+}
+
+template <std::size_t N>
+bool WaitForRunningServices(const char* const (&services)[N], const char* phase) {
+    int stable_polls = 0;
+    for (int poll = 0; poll < kServiceWaitPolls; ++poll) {
+        bool all_running = true;
+        for (const char* service : services) {
+            if (ReadProperty(std::string("init.svc.") + service) != "running") {
+                all_running = false;
+                break;
+            }
+        }
+        if (all_running) {
+            if (++stable_polls >= kStableServicePolls) return true;
+        } else {
+            stable_polls = 0;
+        }
+        usleep(kServicePollIntervalUs);
+    }
+
+    LOGERR("Oplus H.40 decrypt: timed out waiting for %s services\n", phase);
+    for (const char* service : services) {
+        const std::string state = ReadProperty(std::string("init.svc.") + service);
+        LOGERR("Oplus H.40 decrypt: init.svc.%s=%s\n", service, state.c_str());
+    }
+    return false;
+}
+
+bool WaitForStoppedGatekeeper() {
+    for (int poll = 0; poll < kServiceWaitPolls; ++poll) {
+        if (ReadProperty("init.svc.gatekeeperd") == "stopped") return true;
+        usleep(kServicePollIntervalUs);
+    }
+    LOGERR("Oplus H.40 decrypt: gatekeeperd did not stop before metadata mapping (state=%s)\n",
+           ReadProperty("init.svc.gatekeeperd").c_str());
+    return false;
+}
+
+bool WaitForPropertyValue(const char* name, const char* expected, const char* phase) {
+    for (int poll = 0; poll < kServiceWaitPolls; ++poll) {
+        if (ReadProperty(name) == expected) return true;
+        usleep(kServicePollIntervalUs);
+    }
+    LOGERR("Oplus H.40 decrypt: timed out waiting for %s (%s=%s, expected %s)\n",
+           phase, name, ReadProperty(name).c_str(), expected);
+    return false;
+}
+
+bool WaitForCryptoengEndpoint() {
+    android::sp<IServiceManager> manager = defaultServiceManager();
+    if (manager == nullptr) {
+        LOGERR("Oplus H.40 decrypt: no binderized HIDL service manager\n");
+        return false;
+    }
+
+    int stable_polls = 0;
+    for (int poll = 0; poll < kServiceWaitPolls; ++poll) {
+        bool endpoint_ready = false;
+        bool services_running = true;
+        for (const char* service_name : kMetadataServices) {
+            if (ReadProperty(std::string("init.svc.") + service_name) != "running") {
+                services_running = false;
+                break;
+            }
+        }
+        if (services_running) {
+            auto get_result = manager->get(kCryptoengFqName, kCryptoengInstance);
+            if (get_result.isOk()) {
+                android::sp<IBase> service = get_result;
+                if (service != nullptr) {
+                    auto ping_result = service->ping();
+                    endpoint_ready = ping_result.isOk();
+                }
+            }
+        }
+
+        if (endpoint_ready) {
+            if (++stable_polls >= kStableServicePolls) {
+                LOGINFO("Oplus H.40 v3 ICryptoeng/default binderized get+ping ready after %d stable samples\n",
+                        kStableServicePolls);
+                return true;
+            }
+        } else {
+            stable_polls = 0;
+        }
+        usleep(kServicePollIntervalUs);
+    }
+
+    LOGERR("Oplus H.40 decrypt: timed out waiting for binderized %s/%s get+ping\n",
+           kCryptoengFqName, kCryptoengInstance);
+    return false;
+}
+
+bool PrepareMetadataServices() {
+    // H.40's default class may already have started gatekeeperd. Android init's
+    // explicit stop disables further class restarts; this adapter starts it
+    // again only after the OEM metadata routine maps and mounts /data.
+    if (!SetProperty("ctl.stop", "gatekeeperd") || !WaitForStoppedGatekeeper()) return false;
+
+    // This is H.40 stock recovery's own trigger. It starts the exact qseecomd,
+    // keymaster-4-0, and hwservicemanager definitions from stock init.rc.
+    if (!SetProperty("enable.qseecomd.service", "1")) return false;
+
+    // cryptoeng is normally started by `on fs`; request it again so a prior
+    // missing-CommonDCS linker crash can recover in the opt-in image.
+    if (!SetProperty("ctl.start", "hal_cryptoeng_oplus")) return false;
+    if (!WaitForRunningServices(kMetadataServices, "metadata crypto")) return false;
+    if (!WaitForPropertyValue("hwservicemanager.ready", "true",
+                              "hwservicemanager readiness")) {
+        return false;
+    }
+    return WaitForCryptoengEndpoint();
+}
+
+bool MarkDataMappedAndStartGatekeeper() {
+    RuntimeState& state = GetRuntimeState();
+    if (state.data_mapped) return true;
+
+    // Stock recovery publishes this only after the OEM metadata mount returns
+    // success. gatekeeperd's working directory is on /data, so keep its start
+    // behind the same boundary.
+    if (!SetProperty("vendor.data.mounted", "1")) return false;
+    SetProperty("ctl.start", "vendor.gatekeeper-1-0");
+    SetProperty("ctl.start", "gatekeeperd");
+    state.data_mapped = true;
+    return true;
+}
+
+bool PrepareCredentialServices() {
+    if (!GetRuntimeState().data_mapped) {
+        LOGERR("Oplus H.40 decrypt: refusing to start gatekeeper before mapped /data\n");
+        return false;
+    }
+    if (!SetProperty("ctl.start", "vendor.gatekeeper-1-0")) return false;
+    // The OEM verifier talks directly to the vendor gatekeeper HIDL HAL.
+    // gatekeeperd is useful to the surrounding recovery, but its /data working
+    // directory must not make the direct OEM credential call fail.
+    SetProperty("ctl.start", "gatekeeperd");
+    return WaitForRunningServices(kCredentialHalServices, "credential HAL");
+}
+
+template <typename T>
+T FindSymbol(void* handle, const char* name) {
+    dlerror();
+    void* symbol = dlsym(handle, name);
+    const char* error = dlerror();
+    if (error != nullptr) {
+        LOGERR("Oplus H.40 decrypt: missing symbol %s: %s\n", name, error);
+        return nullptr;
+    }
+    return reinterpret_cast<T>(symbol);
+}
+
+const Api& GetApi() {
+    static const Api api = [] {
+        Api loaded;
+        loaded.handle = dlopen(kLibrary, RTLD_NOW | RTLD_LOCAL);
+        if (loaded.handle == nullptr) {
+            LOGINFO("Oplus H.40 decrypt unavailable: %s\n", dlerror());
+            return loaded;
+        }
+        loaded.verify = FindSymbol<VerifyFn>(loaded.handle, kVerifySymbol);
+        loaded.setup_de_ce = FindSymbol<SetupDeCeFn>(loaded.handle, kSetupDeCeSymbol);
+        loaded.get_password_type =
+                FindSymbol<GetPasswordTypeFn>(loaded.handle, kGetPasswordTypeSymbol);
+        loaded.init_user0_ce = FindSymbol<InitUser0CeFn>(loaded.handle, kInitUser0CeSymbol);
+        loaded.mount_metadata = FindSymbol<MountMetadataFn>(loaded.handle, kMountMetadataSymbol);
+        if (loaded.verify == nullptr || loaded.setup_de_ce == nullptr ||
+            loaded.get_password_type == nullptr || loaded.init_user0_ce == nullptr ||
+            loaded.mount_metadata == nullptr) {
+            dlclose(loaded.handle);
+            loaded = {};
+            return loaded;
+        }
+        LOGINFO("Oplus H.40 decrypt ABI loaded\n");
+        return loaded;
+    }();
+    return api;
+}
+
+RuntimeState& GetRuntimeState() {
+    static RuntimeState state;
+    return state;
+}
+
+bool CheckReadableFile(const char* path) {
+    struct stat status = {};
+    if (stat(path, &status) != 0) {
+        LOGERR("Oplus H.40 decrypt: cannot stat required plaintext file %s: %s\n",
+               path, strerror(errno));
+        return false;
+    }
+    if (!S_ISREG(status.st_mode)) {
+        LOGERR("Oplus H.40 decrypt: required plaintext path is not a file: %s\n", path);
+        return false;
+    }
+    if (access(path, R_OK) != 0) {
+        LOGERR("Oplus H.40 decrypt: required plaintext file is unreadable: %s (%s)\n",
+               path, strerror(errno));
+        return false;
+    }
+    return true;
+}
+
+bool CheckReadableDirectory(const char* path) {
+    struct stat status = {};
+    if (stat(path, &status) != 0) {
+        LOGERR("Oplus H.40 decrypt: cannot stat required plaintext directory %s: %s\n",
+               path, strerror(errno));
+        return false;
+    }
+    if (!S_ISDIR(status.st_mode)) {
+        LOGERR("Oplus H.40 decrypt: required plaintext path is not a directory: %s\n", path);
+        return false;
+    }
+    DIR* directory = opendir(path);
+    if (directory == nullptr) {
+        LOGERR("Oplus H.40 decrypt: cannot enumerate plaintext directory %s: %s\n",
+               path, strerror(errno));
+        return false;
+    }
+    errno = 0;
+    while (readdir(directory) != nullptr) {
+        // Confirm that the tree is traversable. The authoritative CE-key proof
+        // is the policy/key-status ioctl pair in CheckFscryptKeyPresent().
+    }
+    if (errno != 0) {
+        LOGERR("Oplus H.40 decrypt: cannot read plaintext directory %s: %s\n",
+               path, strerror(errno));
+        closedir(directory);
+        return false;
+    }
+    closedir(directory);
+    return true;
+}
+
+bool ParseCanonicalUserId(const std::string& name, const char* suffix, int* user_id) {
+    std::string stem = name;
+    const std::string wanted_suffix = suffix;
+    if (!wanted_suffix.empty()) {
+        if (stem.size() <= wanted_suffix.size() ||
+            stem.compare(stem.size() - wanted_suffix.size(), wanted_suffix.size(),
+                         wanted_suffix) != 0) {
+            return false;
+        }
+        stem.resize(stem.size() - wanted_suffix.size());
+    }
+    if (stem.empty()) return false;
+
+    int parsed = 0;
+    for (char character : stem) {
+        if (character < '0' || character > '9') return false;
+        if (parsed > (9999 - (character - '0')) / 10) {
+            *user_id = INT_MAX;
+            return true;
+        }
+        parsed = parsed * 10 + (character - '0');
+    }
+    // Treat noncanonical aliases such as 00 as unsupported user state.
+    if ((parsed == 0 && stem != "0") || (parsed != 0 && stem[0] == '0')) {
+        *user_id = INT_MAX;
+        return true;
+    }
+    *user_id = parsed;
+    return true;
+}
+
+bool ScanSingleUserDirectory(const char* path, const char* suffix, bool require_user0) {
+    DIR* directory = opendir(path);
+    if (directory == nullptr) {
+        LOGERR("Oplus H.40 decrypt: cannot scan %s: %s\n", path, strerror(errno));
+        return false;
+    }
+
+    bool found_user0 = false;
+    bool valid = true;
+    errno = 0;
+    while (dirent* entry = readdir(directory)) {
+        int user_id = -1;
+        if (!ParseCanonicalUserId(entry->d_name, suffix, &user_id)) continue;
+        if (user_id != 0) {
+            LOGERR("Oplus H.40 user0-only mode refusing secondary/unsupported user id %d from %s/%s\n",
+                   user_id, path, entry->d_name);
+            valid = false;
+            break;
+        }
+        found_user0 = true;
+    }
+    if (valid && errno != 0) {
+        LOGERR("Oplus H.40 decrypt: error while scanning %s: %s\n", path, strerror(errno));
+        valid = false;
+    }
+    closedir(directory);
+
+    if (valid && require_user0 && !found_user0) {
+        LOGERR("Oplus H.40 decrypt: user 0 is missing from %s\n", path);
+        valid = false;
+    }
+    return valid;
+}
+
+bool ValidateSingleUser0DeLayout() {
+    if (!CheckReadableFile("/data/unencrypted/key/version")) return false;
+    if (!CheckReadableDirectory("/data/system_de/0")) return false;
+    if (!CheckReadableFile("/data/system/users/0.xml")) return false;
+    if (!ScanSingleUserDirectory("/data/system_de", "", true)) return false;
+    if (!ScanSingleUserDirectory("/data/system/users", "", false)) return false;
+    if (!ScanSingleUserDirectory("/data/system/users", ".xml", true)) return false;
+    return true;
+}
+
+bool CheckFscryptKeyPresent(const char* path) {
+    const int directory_fd = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (directory_fd < 0) {
+        LOGERR("Oplus H.40 v3 cannot open CE path for fscrypt ioctls %s: %s\n",
+               path, strerror(errno));
+        return false;
+    }
+
+    struct fscrypt_get_policy_ex_arg policy_arg = {};
+    policy_arg.policy_size = sizeof(policy_arg.policy);
+    if (ioctl(directory_fd, FS_IOC_GET_ENCRYPTION_POLICY_EX, &policy_arg) != 0) {
+        LOGERR("Oplus H.40 v3 FS_IOC_GET_ENCRYPTION_POLICY_EX failed for %s: %s\n",
+               path, strerror(errno));
+        close(directory_fd);
+        return false;
+    }
+
+    struct fscrypt_get_key_status_arg status_arg = {};
+    const unsigned int policy_version = policy_arg.policy.version;
+    if (policy_version == FSCRYPT_POLICY_V1) {
+        if (policy_arg.policy_size != sizeof(policy_arg.policy.v1)) {
+            LOGERR("Oplus H.40 v3 invalid fscrypt v1 policy size for %s: %llu bytes\n",
+                   path, static_cast<unsigned long long>(policy_arg.policy_size));
+            close(directory_fd);
+            return false;
+        }
+        status_arg.key_spec.type = FSCRYPT_KEY_SPEC_TYPE_DESCRIPTOR;
+        memcpy(status_arg.key_spec.u.descriptor,
+               policy_arg.policy.v1.master_key_descriptor,
+               FSCRYPT_KEY_DESCRIPTOR_SIZE);
+    } else if (policy_version == FSCRYPT_POLICY_V2) {
+        if (policy_arg.policy_size != sizeof(policy_arg.policy.v2)) {
+            LOGERR("Oplus H.40 v3 invalid fscrypt v2 policy size for %s: %llu bytes\n",
+                   path, static_cast<unsigned long long>(policy_arg.policy_size));
+            close(directory_fd);
+            return false;
+        }
+        status_arg.key_spec.type = FSCRYPT_KEY_SPEC_TYPE_IDENTIFIER;
+        memcpy(status_arg.key_spec.u.identifier,
+               policy_arg.policy.v2.master_key_identifier,
+               FSCRYPT_KEY_IDENTIFIER_SIZE);
+    } else {
+        LOGERR("Oplus H.40 v3 unsupported fscrypt policy version %u for %s\n",
+               policy_version, path);
+        close(directory_fd);
+        return false;
+    }
+
+    LOGINFO("Oplus H.40 v3 FS_IOC_GET_ENCRYPTION_POLICY_EX version=%u for %s\n",
+            policy_version, path);
+    if (ioctl(directory_fd, FS_IOC_GET_ENCRYPTION_KEY_STATUS, &status_arg) != 0) {
+        LOGERR("Oplus H.40 v3 FS_IOC_GET_ENCRYPTION_KEY_STATUS failed for %s: %s\n",
+               path, strerror(errno));
+        close(directory_fd);
+        return false;
+    }
+    close(directory_fd);
+
+    if (status_arg.status != FSCRYPT_KEY_STATUS_PRESENT) {
+        LOGERR("Oplus H.40 v3 FS_IOC_GET_ENCRYPTION_KEY_STATUS not PRESENT for %s: status=%u\n",
+               path, status_arg.status);
+        return false;
+    }
+    LOGINFO("Oplus H.40 v3 FS_IOC_GET_ENCRYPTION_KEY_STATUS PRESENT for %s: status=%u\n",
+            path, status_arg.status);
+    return true;
+}
+
+bool ValidateUser0CeLayout() {
+    if (!CheckReadableDirectory("/data/system_ce/0")) return false;
+    if (!CheckFscryptKeyPresent("/data/system_ce/0")) return false;
+    if (!CheckReadableDirectory("/data/media/0")) return false;
+    if (!CheckFscryptKeyPresent("/data/media/0")) return false;
+    return true;
+}
+
+bool ValidateMapper(User0State* user0_state) {
+    const std::string mapper = ReadProperty("ro.crypto.fs_crypto_blkdev");
+    struct stat status = {};
+    if (mapper.empty() || mapper == "error") {
+        LOGERR("Oplus H.40 decrypt: metadata mapper property is empty or invalid\n");
+        return false;
+    }
+    if (stat(mapper.c_str(), &status) != 0) {
+        LOGERR("Oplus H.40 decrypt: cannot stat metadata mapper '%s': %s\n",
+               mapper.c_str(), strerror(errno));
+        return false;
+    }
+    if (!S_ISBLK(status.st_mode)) {
+        LOGERR("Oplus H.40 decrypt: metadata mapper is not a block device: %s\n",
+               mapper.c_str());
+        return false;
+    }
+    user0_state->crypto_block_device = mapper;
+    return true;
+}
+
+bool MapPasswordType(int raw_password_type, int* twrp_password_type) {
+    switch (raw_password_type) {
+        case -1:  // No credential, but only authoritative after CE succeeds.
+            *twrp_password_type = 0;
+            return true;
+        case 1:  // Android pattern.
+            *twrp_password_type = 2;
+            return true;
+        case 2:  // Legacy password-or-PIN; use TWRP's unrestricted keyboard.
+            *twrp_password_type = 1;
+            return true;
+        case 3:  // Android PIN.
+            *twrp_password_type = 3;
+            return true;
+        case 4:  // Android password.
+            *twrp_password_type = 1;
+            return true;
+        default:
+            LOGERR("Oplus H.40 decrypt: unsupported user 0 password type %d\n",
+                   raw_password_type);
+            return false;
+    }
+}
+
+bool PrepareUser0DeState(const Api& api, User0State* user0_state) {
+    LOGINFO("Oplus H.40 invoking setup_de_ce(0)\n");
+    const bool setup_succeeded = api.setup_de_ce(0);
+    LOGINFO("Oplus H.40 setup_de_ce(0) returned %d\n", setup_succeeded);
+    if (!setup_succeeded) return false;
+
+    if (!SetProperty("recovery.reload.persist", "trigger_reload_persist")) return false;
+    sleep(1);
+
+    if (!ValidateSingleUser0DeLayout()) return false;
+
+    const int raw_password_type = api.get_password_type(0);
+    int twrp_password_type = 0;
+    if (!MapPasswordType(raw_password_type, &twrp_password_type)) return false;
+
+    user0_state->raw_password_type = raw_password_type;
+    user0_state->twrp_password_type = twrp_password_type;
+    user0_state->no_credential = raw_password_type == -1;
+    LOGINFO("Oplus H.40 user 0 password type raw=%d mapped_twrp=%d\n",
+            raw_password_type, twrp_password_type);
+
+    if (user0_state->no_credential) {
+        // OEM -1 can also represent a read failure. It means "no credential"
+        // only when the OEM CE helper proves that the no-lock key is usable.
+        RuntimeState& state = GetRuntimeState();
+        state.user0_ce_ready = api.init_user0_ce();
+        LOGINFO("Oplus H.40 no-credential CE postcondition returned %d\n",
+                state.user0_ce_ready);
+        if (!state.user0_ce_ready) return false;
+        if (!ValidateUser0CeLayout()) return false;
+    } else {
+        // Credentialed synthetic-password state must be plaintext after DE.
+        // get_password_type() proves that the OEM *.pwd record was readable;
+        // this directory check proves the containing SP state is traversable.
+        if (!CheckReadableDirectory("/data/system_de/0/spblob")) return false;
+    }
+
+    LOGINFO("Oplus H.40 user 0 DE state validated\n");
+    return true;
+}
+
+}  // namespace
+
+bool IsActive() {
+    std::lock_guard<std::mutex> lock(GetRuntimeMutex());
+    return GetRuntimeState().phase != Phase::kIdle;
+}
+
+Result MountMetadataAndPrepareDe(const std::string& mount_point, User0State* user0_state) {
+    std::lock_guard<std::mutex> lock(GetRuntimeMutex());
+    if (user0_state == nullptr || mount_point != "/data") {
+        LOGERR("Oplus H.40 decrypt: refusing invalid metadata request for '%s'\n",
+               mount_point.c_str());
+        return Result::kFailure;
+    }
+
+    const Api& api = GetApi();
+    if (api.handle == nullptr) return Result::kUnavailable;
+
+    RuntimeState& state = GetRuntimeState();
+    if (state.phase == Phase::kFatal) return Result::kFailure;
+    if (state.phase == Phase::kPreparedLocked || state.phase == Phase::kPreparedNoLock) {
+        *user0_state = state.user0;
+        return Result::kSuccess;
+    }
+    if (state.phase == Phase::kUnlocked) {
+        return FailActive("metadata preparation requested after CE unlock");
+    }
+    if (state.phase != Phase::kIdle) {
+        return FailActive("reentrant metadata preparation");
+    }
+
+    state.phase = Phase::kActive;
+    LOGINFO("Oplus H.40 v3 adapter activated; generic keystore2 fallback is now forbidden\n");
+
+    if (!PrepareMetadataServices()) return FailActive("metadata crypto services unavailable");
+
+    LOGINFO("Oplus H.40 invoking metadata mount for %s\n", mount_point.c_str());
+    const bool mounted = api.mount_metadata(mount_point);
+    LOGINFO("Oplus H.40 metadata mount for %s returned %d\n", mount_point.c_str(), mounted);
+    if (!mounted) return FailActive("OEM metadata mount failed");
+
+    if (!ValidateMapper(&state.user0)) return FailActive("metadata mapper validation failed");
+    if (!MarkDataMappedAndStartGatekeeper()) {
+        return FailActive("post-map property/service sequence failed");
+    }
+    if (!PrepareUser0DeState(api, &state.user0)) {
+        return FailActive("user 0 DE/password state validation failed");
+    }
+
+    state.phase = state.user0.no_credential ? Phase::kPreparedNoLock : Phase::kPreparedLocked;
+    *user0_state = state.user0;
+    return Result::kSuccess;
+}
+
+Result DecryptUser(const std::string& password, int user_id) {
+    std::lock_guard<std::mutex> lock(GetRuntimeMutex());
+    RuntimeState& state = GetRuntimeState();
+    if (state.phase == Phase::kIdle) return Result::kUnavailable;
+    if (state.phase == Phase::kFatal || state.phase == Phase::kActive ||
+        state.phase == Phase::kUnlocked) {
+        return Result::kFailure;
+    }
+
+    // The H.40 implementation always calls fscrypt_init_user0_ce(), even when
+    // its integer argument is nonzero. Once OEM setup is active, a secondary
+    // user is an authoritative refusal, never a generic-fallback opportunity.
+    if (user_id != 0) {
+        LOGERR("Oplus H.40 user0-only mode refusing credential for user %d\n", user_id);
+        return Result::kFailure;
+    }
+
+    const Api& api = GetApi();
+    if (api.handle == nullptr) return FailActive("OEM ABI disappeared after activation");
+
+    if (password == "!") {
+        if (!state.user0.no_credential) {
+            LOGERR("Oplus H.40 decrypt: refusing no-lock probe for credentialed user 0\n");
+            return Result::kFailure;
+        }
+
+        // Recheck current CE state instead of trusting the setup-time result.
+        LOGINFO("Oplus H.40 rechecking no-credential user 0 CE postcondition\n");
+        state.user0_ce_ready = api.init_user0_ce();
+        LOGINFO("Oplus H.40 no-credential user 0 CE recheck returned %d\n",
+                state.user0_ce_ready);
+        if (!state.user0_ce_ready) {
+            return FailActive("no-credential CE recheck failed");
+        }
+        if (!ValidateUser0CeLayout()) {
+            return FailActive("no-credential CE paths are not accessible");
+        }
+        state.phase = Phase::kUnlocked;
+        LOGINFO("Oplus H.40 v3 no-lock user 0 CE postcondition satisfied\n");
+        return Result::kSuccess;
+    }
+
+    if (state.user0.no_credential) {
+        LOGERR("Oplus H.40 decrypt: refusing credential verify for no-lock user 0\n");
+        return Result::kFailure;
+    }
+    if (!PrepareCredentialServices()) return Result::kFailure;
+
+    LOGINFO("Oplus H.40 invoking credential verify for user 0\n");
+    const int verify_result = api.verify(password, 0);
+    LOGINFO("Oplus H.40 credential verify for user 0 returned %d\n", verify_result);
+    if (verify_result != 0) {
+        // A wrong credential is authoritative for this attempt but retryable;
+        // do not poison the process-lifetime setup state.
+        return Result::kFailure;
+    }
+
+    // OplusCredentialVerify returns 0 after a successful gatekeeper response
+    // even if its internal fscrypt_init_user0_ce() call fails. Repeating the
+    // idempotent helper supplies the missing CE-key postcondition.
+    LOGINFO("Oplus H.40 invoking user 0 CE postcondition\n");
+    state.user0_ce_ready = api.init_user0_ce();
+    LOGINFO("Oplus H.40 user 0 CE postcondition returned %d\n", state.user0_ce_ready);
+    if (!state.user0_ce_ready) {
+        return FailActive("CE postcondition failed after accepted credential");
+    }
+    if (!ValidateUser0CeLayout()) {
+        return FailActive("CE paths are not accessible after accepted credential");
+    }
+    state.phase = Phase::kUnlocked;
+    LOGINFO("Oplus H.40 v3 user 0 CE postcondition satisfied\n");
+    return Result::kSuccess;
+}
+
+}  // namespace oplus_h40
+}  // namespace twrp
