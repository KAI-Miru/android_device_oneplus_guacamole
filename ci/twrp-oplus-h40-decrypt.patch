+bool IsOplusMapperMountedAtData(const std::string& mapper) {
+	struct stat mapper_status = {};
+	struct stat data_status = {};
+	if (stat(mapper.c_str(), &mapper_status) != 0) {
+		LOGERR("Oplus H.40 decrypt: cannot stat metadata mapper '%s': %s\n",
+			mapper.c_str(), strerror(errno));
+		return false;
+	}
+	if (!S_ISBLK(mapper_status.st_mode)) {
+		LOGERR("Oplus H.40 decrypt: metadata mapper is not a block device: %s\n",
+			mapper.c_str());
+		return false;
+	}
+	if (stat("/data", &data_status) != 0) {
+		LOGERR("Oplus H.40 decrypt: mounted /data cannot be inspected: %s\n", strerror(errno));
+		return false;
+	}
+	if (!S_ISDIR(data_status.st_mode)) {
+		LOGERR("Oplus H.40 decrypt: /data is not a directory after OEM metadata setup\n");
+		return false;
+	}
+	if (data_status.st_dev != mapper_status.st_rdev) {
+		LOGERR("Oplus H.40 decrypt: /data device %llu does not match mapper %s device %llu\n",
+			static_cast<unsigned long long>(data_status.st_dev), mapper.c_str(),
+			static_cast<unsigned long long>(mapper_status.st_rdev));
+		return false;
+	}
+	return true;
+}
