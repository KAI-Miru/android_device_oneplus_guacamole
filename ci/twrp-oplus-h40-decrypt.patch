diff --git a/oplus_h40_decrypt.cpp b/oplus_h40_decrypt.cpp
new file mode 100644
index 0000000..6a80aba
--- /dev/null
+++ b/oplus_h40_decrypt.cpp
@@ -0,0 +1,158 @@
+#include "oplus_h40_decrypt.hpp"
+
+#include <dlfcn.h>
+
+#include <string>
+
+#include "twcommon.h"
+
+namespace twrp {
+namespace oplus_h40 {
+namespace {
+
+constexpr char kLibrary[] = "libdecrypt_recovery.so";
+constexpr char kVerifySymbol[] =
+        "_Z21OplusCredentialVerifyNSt3__112basic_stringIcNS_11char_traitsIcEENS_9allocatorIcEEEEi";
+constexpr char kSetupDeCeSymbol[] = "_Z11setup_de_cei";
+constexpr char kGetPasswordTypeSymbol[] = "_Z17get_password_typei";
+constexpr char kInitUser0CeSymbol[] = "_Z21fscrypt_init_user0_cev";
+constexpr char kMountMetadataSymbol[] =
+        "_Z32fscrypt_mount_metadata_encryptedRKNSt3__112basic_stringIcNS_11char_traitsIcEENS_9allocatorIcEEEE";
+
+using VerifyFn = int (*)(std::string, int);
+using SetupDeCeFn = bool (*)(int);
+using GetPasswordTypeFn = int (*)(int);
+using InitUser0CeFn = bool (*)();
+using MountMetadataFn = bool (*)(const std::string&);
+
+struct Api {
+    void* handle = nullptr;
+    VerifyFn verify = nullptr;
+    SetupDeCeFn setup_de_ce = nullptr;
+    GetPasswordTypeFn get_password_type = nullptr;
+    InitUser0CeFn init_user0_ce = nullptr;
+    MountMetadataFn mount_metadata = nullptr;
+};
+
+struct RuntimeState {
+    bool setup_invoked = false;
+    bool user0_ce_ready = false;
+};
+
+template <typename T>
+T FindSymbol(void* handle, const char* name) {
+    dlerror();
+    void* symbol = dlsym(handle, name);
+    const char* error = dlerror();
+    if (error != nullptr) {
+        LOGERR("Oplus H.40 decrypt: missing symbol %s: %s\n", name, error);
+        return nullptr;
+    }
+    return reinterpret_cast<T>(symbol);
+}
+
+const Api& GetApi() {
+    static const Api api = [] {
+        Api loaded;
+        loaded.handle = dlopen(kLibrary, RTLD_NOW | RTLD_LOCAL);
+        if (loaded.handle == nullptr) {
+            LOGINFO("Oplus H.40 decrypt unavailable: %s\n", dlerror());
+            return loaded;
+        }
+        loaded.verify = FindSymbol<VerifyFn>(loaded.handle, kVerifySymbol);
+        loaded.setup_de_ce = FindSymbol<SetupDeCeFn>(loaded.handle, kSetupDeCeSymbol);
+        loaded.get_password_type =
+                FindSymbol<GetPasswordTypeFn>(loaded.handle, kGetPasswordTypeSymbol);
+        loaded.init_user0_ce = FindSymbol<InitUser0CeFn>(loaded.handle, kInitUser0CeSymbol);
+        loaded.mount_metadata = FindSymbol<MountMetadataFn>(loaded.handle, kMountMetadataSymbol);
+        if (loaded.verify == nullptr || loaded.setup_de_ce == nullptr ||
+            loaded.get_password_type == nullptr || loaded.init_user0_ce == nullptr ||
+            loaded.mount_metadata == nullptr) {
+            dlclose(loaded.handle);
+            loaded = {};
+            return loaded;
+        }
+        LOGINFO("Oplus H.40 decrypt ABI loaded\n");
+        return loaded;
+    }();
+    return api;
+}
+
+RuntimeState& GetRuntimeState() {
+    static RuntimeState state;
+    return state;
+}
+
+void EnsureDeSetup(const Api& api) {
+    RuntimeState& state = GetRuntimeState();
+    if (state.setup_invoked) return;
+
+    // Stock H.40 invokes setup_de_ce immediately after metadata mapping. Its
+    // implementation returns true at its common exit even after some internal
+    // failures, so the return is diagnostic only. TWRP's normal Decrypt_FBE_DE
+    // pass remains responsible for validating DE and populating its user map.
+    state.setup_invoked = true;
+    LOGINFO("Oplus H.40 invoking setup_de_ce(0)\n");
+    const bool setup_result = api.setup_de_ce(0);
+    LOGINFO("Oplus H.40 setup_de_ce(0) returned %d (diagnostic only)\n", setup_result);
+
+    // setup_de_ce(0) uses -1 from the OEM password-type function as its
+    // no-credential signal and attempts user-0 CE in that case. Repeat the
+    // exported idempotent helper so a later TWRP "!" probe has a real boolean
+    // postcondition without making a gatekeeper request.
+    const int password_type = api.get_password_type(0);
+    LOGINFO("Oplus H.40 password type for user 0 returned %d\n", password_type);
+    if (password_type == -1) {
+        state.user0_ce_ready = api.init_user0_ce();
+        LOGINFO("Oplus H.40 no-credential CE postcondition returned %d\n",
+                state.user0_ce_ready);
+    }
+}
+
+}  // namespace
+
+Result MountMetadataAndPrepareDe(const std::string& mount_point) {
+    const Api& api = GetApi();
+    if (api.handle == nullptr) return Result::kUnavailable;
+    LOGINFO("Oplus H.40 invoking metadata mount for %s\n", mount_point.c_str());
+    const bool mounted = api.mount_metadata(mount_point);
+    LOGINFO("Oplus H.40 metadata mount for %s returned %d\n", mount_point.c_str(), mounted);
+    if (!mounted) return Result::kFailure;
+
+    EnsureDeSetup(api);
+    return Result::kSuccess;
+}
+
+Result DecryptUser(const std::string& password, int user_id) {
+    // The H.40 implementation always calls fscrypt_init_user0_ce(), even when
+    // its integer argument is nonzero. It is therefore valid only for user 0.
+    if (user_id != 0) return Result::kUnavailable;
+
+    const Api& api = GetApi();
+    if (api.handle == nullptr) return Result::kUnavailable;
+
+    // This is normally completed directly after OEM metadata mapping. Keep a
+    // late setup path for a build where generic metadata mounting was selected.
+    EnsureDeSetup(api);
+
+    if (password == "!") {
+        return GetRuntimeState().user0_ce_ready ? Result::kSuccess : Result::kUnavailable;
+    }
+
+    LOGINFO("Oplus H.40 invoking credential verify for user %d\n", user_id);
+    const int verify_result = api.verify(password, user_id);
+    LOGINFO("Oplus H.40 credential verify for user %d returned %d\n", user_id, verify_result);
+    if (verify_result != 0) return Result::kFailure;
+
+    // OplusCredentialVerify returns 0 after a successful gatekeeper response
+    // even if its internal fscrypt_init_user0_ce() call fails. Repeating the
+    // idempotent exported helper gives us the missing CE-key postcondition.
+    LOGINFO("Oplus H.40 invoking user 0 CE postcondition\n");
+    const bool ce_ready = api.init_user0_ce();
+    LOGINFO("Oplus H.40 user 0 CE postcondition returned %d\n", ce_ready);
+    GetRuntimeState().user0_ce_ready = ce_ready;
+    return ce_ready ? Result::kSuccess : Result::kFailure;
+}
+
+}  // namespace oplus_h40
+}  // namespace twrp
diff --git a/oplus_h40_decrypt.hpp b/oplus_h40_decrypt.hpp
new file mode 100644
index 0000000..b4b8ad6
--- /dev/null
+++ b/oplus_h40_decrypt.hpp
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <string>
+
+namespace twrp {
+namespace oplus_h40 {
+
+// Unavailable means that the H.40 blob or required ABI is absent, so the
+// normal TWRP implementation remains eligible as a fallback. Failure means
+// the proprietary implementation ran and rejected the request (or failed its
+// CE-key postcondition); callers must not retry the same credential through a
+// second gatekeeper implementation.
+enum class Result {
+    kUnavailable,
+    kFailure,
+    kSuccess,
+};
+
+Result MountMetadataAndPrepareDe(const std::string& mount_point);
+Result DecryptUser(const std::string& password, int user_id);
+
+}  // namespace oplus_h40
+}  // namespace twrp
