+#include <string>
+
+namespace twrp {
+namespace oplus_h40 {
+
+// Values needed to construct TWRP's deliberately minimal user-0-only FBE
+// state without invoking TeamWin vold's keystore2-backed DE implementation.
+struct User0State {
+    int raw_password_type = 0;
+    int twrp_password_type = 0;
+    bool no_credential = false;
+    std::string crypto_block_device;
+};
+
+// Unavailable is possible only before the OEM implementation has performed
+// any side effect. Once selected, every refusal or runtime failure is
+// authoritative and callers must not fall through to another decrypt stack.
+enum class Result {
+    kUnavailable,
+    kFailure,
+    kSuccess,
+};
+
+bool IsActive();
+Result MountMetadataAndPrepareDe(const std::string& mount_point, User0State* user0_state);
+Result DecryptUser(const std::string& password, int user_id);
+
+}  // namespace oplus_h40
+}  // namespace twrp
